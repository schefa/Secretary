<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade" version="4.0">
    <name>COM_SECRETARY</name>
    <creationDate>2026-08-24</creationDate>
    <copyright>Copyright (C) 2015 - 2018. Fjodor Schaefer</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <author>Fjodor Schaefer</author>
    <authorEmail>info@schefa.com</authorEmail>
    <authorUrl>https://www.schefa.com</authorUrl>
    <version>4.2.0</version>
    <description>Business Software for Freelancers, small and medium-sized enterprises</description>
    <updateservers>
        <server type="extension" priority="1" name="com_secretary"><![CDATA[https://raw.githubusercontent.com/schefa/Secretary/refs/heads/master/secretary.xml]]>
        </server>
    </updateservers>
    <install>
        <sql>
            <file charset="utf8" driver="mysql">application/install/sql/install.mysql.sql</file>
            <file charset="utf8" driver="postgresql">application/install/sql/install.postgresql.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file charset="utf8" driver="mysql">application/install/sql/uninstall.mysql.sql</file>
            <file charset="utf8" driver="postgresql">application/install/sql/uninstall.postgresql.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">application/install/sql/updates/mysql</schemapath>
            <schemapath type="postgresql">application/install/sql/updates/postgresql</schemapath>
        </schemas>
    </update>
    <scriptfile>script.php</scriptfile>
    <media destination="secretary" folder="media">
        <filename>index.html</filename>
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
        <folder>assets</folder>
    </media>
    <administration>
        <menu link="option=com_secretary">COM_SECRETARY</menu>
        <files folder="admin">
            <folder>application</folder>
            <folder>controllers</folder>
            <folder>models</folder>
            <!-- <folder>uploads</folder> -->
            <folder>views</folder>
            <filename>index.html</filename>
            <filename>controller.php</filename>
            <filename>secretary.php</filename>
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>LICENSE.txt</filename>
            <filename>htaccess.txt</filename>
        </files>
        <languages>
            <language tag="en-GB">admin/application/language/en-GB/en-GB.com_secretary.ini</language>
            <language tag="en-GB">admin/application/language/en-GB/en-GB.com_secretary.sys.ini</language>
            <language tag="de-DE">admin/application/language/de-DE/de-DE.com_secretary.ini</language>
            <language tag="de-DE">admin/application/language/de-DE/de-DE.com_secretary.sys.ini</language>
        </languages>
    </administration>
    <files folder="site">
        <folder>views</folder>
        <filename>index.html</filename>
        <filename>router.php</filename>
        <filename>secretary.php</filename>
    </files>
</extension>

