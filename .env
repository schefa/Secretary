# Local dev stack credentials, read by both `docker compose` (built-in .env
# support) and the Makefile (`include .env`). These are throwaway credentials
# for the local Docker stack only - not used anywhere outside this repo - so
# this file is committed rather than gitignored. Override per-invocation with
# `make up DEV_DB_PASSWORD=...` instead of editing this file, if you just want
# a one-off change.
MYSQL_ROOT_PASSWORD=password
DEV_DB_NAME=dev
DEV_DB_USER=dev
DEV_DB_PASSWORD=root
SECRETARY_DEV_ADMIN_USERNAME=admin
SECRETARY_DEV_ADMIN_PASSWORD=Secretary123!
SECRETARY_DEV_ADMIN_EMAIL=admin@example.com
JOOMLA_VERSION=5.4.8
